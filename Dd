const PATTERNS=[{"cat":"기초 요청","form":"Can I + 동사원형?","meaning":"~해도 될까요?","examples":[["Can I sit here?","여기 앉아도 될까요?"],["Can I use the kitchen?","주방을 써도 될까요?"]]},{"cat":"기초 요청","form":"Can I get + 명사?","meaning":"~을 받을 수 있을까요?","examples":[["Can I get some water?","물 좀 받을 수 있을까요?"],["Can I get a receipt?","영수증 받을 수 있을까요?"]]},{"cat":"기초 요청","form":"Could you + 동사원형?","meaning":"~해주시겠어요?","examples":[["Could you help me?","도와주시겠어요?"],["Could you open the door?","문을 열어주시겠어요?"]]},{"cat":"기초 요청","form":"Could I have + 명사?","meaning":"~을 주시겠어요?","examples":[["Could I have a blanket?","담요 하나 주시겠어요?"],["Could I have another towel?","수건 한 장 더 주시겠어요?"]]},{"cat":"기초 요청","form":"Do you mind if I + 동사원형?","meaning":"제가 ~해도 괜찮을까요?","examples":[["Do you mind if I sit here?","제가 여기 앉아도 될까요?"],["Do you mind if I take a picture?","사진 찍어도 될까요?"]]},{"cat":"기초 요청","form":"Would you mind + -ing?","meaning":"~해주시겠어요?","examples":[["Would you mind opening the window?","창문을 열어주시겠어요?"],["Would you mind speaking slowly?","천천히 말씀해주시겠어요?"]]},{"cat":"기초 요청","form":"Is it okay to + 동사원형?","meaning":"~해도 괜찮나요?","examples":[["Is it okay to use this?","이걸 써도 괜찮나요?"],["Is it okay to join you?","함께해도 괜찮나요?"]]},{"cat":"기초 요청","form":"I was wondering if + 문장","meaning":"혹시 ~인지 궁금해서요","examples":[["I was wondering if you could help.","혹시 도와주실 수 있을까 해서요."],["I was wondering if this seat was taken.","이 자리에 사람이 있는지 궁금해서요."]]},{"cat":"기초 요청","form":"Could you tell me + 의문사절?","meaning":"~인지 알려주시겠어요?","examples":[["Could you tell me where the restroom is?","화장실이 어디인지 알려주시겠어요?"],["Could you tell me when the bus leaves?","버스가 언제 떠나는지 알려주시겠어요?"]]},{"cat":"기초 요청","form":"I'd like + 명사","meaning":"~을 원해요","examples":[["I'd like a window seat.","창가 좌석으로 주세요."],["I'd like a cup of coffee.","커피 한 잔 주세요."]]},{"cat":"기초 요청","form":"I'd like to + 동사원형","meaning":"~하고 싶어요","examples":[["I'd like to order now.","이제 주문하고 싶어요."],["I'd like to learn more.","더 배우고 싶어요."]]},{"cat":"기초 요청","form":"I'll have + 명사","meaning":"~로 할게요","examples":[["I'll have the chicken.","닭고기 요리로 할게요."],["I'll have the same thing.","저도 같은 걸로 할게요."]]},{"cat":"기초 요청","form":"Could I ask you + 명사?","meaning":"~을 여쭤봐도 될까요?","examples":[["Could I ask you a question?","질문 하나 해도 될까요?"],["Could I ask you a favor?","부탁 하나 해도 될까요?"]]},{"cat":"기초 요청","form":"Let me + 동사원형","meaning":"제가 ~할게요","examples":[["Let me check.","제가 확인해 볼게요."],["Let me help you.","제가 도와줄게요."]]},{"cat":"기초 요청","form":"Feel free to + 동사원형","meaning":"편하게 ~하세요","examples":[["Feel free to ask questions.","편하게 질문하세요."],["Feel free to sit anywhere.","아무 데나 편하게 앉으세요."]]},{"cat":"기초 요청","form":"Can you show me how to + 동사원형?","meaning":"~하는 방법을 보여줄래요?","examples":[["Can you show me how to get there?","거기 가는 법을 보여줄래요?"],["Can you show me how to use this?","이거 쓰는 법을 보여줄래요?"]]},{"cat":"기초 요청","form":"Could you help me with + 명사?","meaning":"~을 도와주실래요?","examples":[["Could you help me with this bag?","이 가방 좀 도와주실래요?"],["Could you help me with my English?","제 영어를 도와주실래요?"]]},{"cat":"기초 요청","form":"Could you pass me + 명사?","meaning":"~좀 건네줄래요?","examples":[["Could you pass me the salt?","소금 좀 건네줄래요?"],["Could you pass me the cutting board?","도마 좀 건네줄래요?"]]},{"cat":"기초 요청","form":"Can you make it + 형용사?","meaning":"~하게 해 줄래요?","examples":[["Can you make it less spicy?","덜 맵게 해줄래요?"],["Can you make it a little louder?","조금 더 크게 해줄래요?"]]},{"cat":"기초 요청","form":"Would it be okay if + 주어 + 과거형 동사?","meaning":"~해도 괜찮을까요?","examples":[["Would it be okay if I joined you?","제가 함께해도 괜찮을까요?"],["Would it be okay if we prayed for you?","당신을 위해 기도해도 괜찮을까요?"]]},{"cat":"질문과 정보","form":"Where can I + 동사원형?","meaning":"어디에서 ~할 수 있나요?","examples":[["Where can I exchange money?","어디에서 환전할 수 있나요?"],["Where can I get a SIM card?","어디에서 유심을 살 수 있나요?"]]},{"cat":"질문과 정보","form":"How do I + 동사원형?","meaning":"어떻게 ~하나요?","examples":[["How do I get there?","거기 어떻게 가나요?"],["How do I turn this on?","이거 어떻게 켜나요?"]]},{"cat":"질문과 정보","form":"How long does it take to + 동사원형?","meaning":"~하는 데 얼마나 걸리나요?","examples":[["How long does it take to get there?","거기 가는 데 얼마나 걸리나요?"],["How long does it take to cook this?","이거 요리하는 데 얼마나 걸리나요?"]]},{"cat":"질문과 정보","form":"How much does + 주어 + cost?","meaning":"~은 얼마예요?","examples":[["How much does this cost?","이거 얼마예요?"],["How much does a ticket cost?","표는 얼마예요?"]]},{"cat":"질문과 정보","form":"Is there + 명사 + nearby?","meaning":"근처에 ~이 있나요?","examples":[["Is there a pharmacy nearby?","근처에 약국 있나요?"],["Is there a restroom nearby?","근처에 화장실 있나요?"]]},{"cat":"질문과 정보","form":"Do you have + 명사?","meaning":"~이 있나요?","examples":[["Do you have a bigger size?","더 큰 사이즈 있나요?"],["Do you have any water?","물 있나요?"]]},{"cat":"질문과 정보","form":"What's the best way to + 동사원형?","meaning":"~하는 가장 좋은 방법은 뭔가요?","examples":[["What's the best way to get downtown?","시내에 가는 가장 좋은 방법은 뭔가요?"],["What's the best way to learn this?","이걸 배우는 가장 좋은 방법은 뭔가요?"]]},{"cat":"질문과 정보","form":"What do you recommend?","meaning":"뭘 추천하세요?","examples":[["What do you recommend for lunch?","점심으로 뭘 추천하세요?"],["What do you recommend around here?","이 근처에 뭘 추천하세요?"]]},{"cat":"질문과 정보","form":"What does + 명사 + mean?","meaning":"~은 무슨 뜻인가요?","examples":[["What does this word mean?","이 단어는 무슨 뜻인가요?"],["What does this sign mean?","이 표지판은 무슨 뜻인가요?"]]},{"cat":"질문과 정보","form":"What do you mean by + 명사?","meaning":"~이라는 게 무슨 뜻인가요?","examples":[["What do you mean by that?","그게 무슨 뜻인가요?"],["What do you mean by soon?","곧이라는 게 무슨 뜻인가요?"]]},{"cat":"질문과 정보","form":"How come + 문장?","meaning":"어째서 ~해요?","examples":[["How come you're so early?","왜 이렇게 일찍 왔어요?"],["How come the store is closed?","왜 가게가 닫혀 있어요?"]]},{"cat":"질문과 정보","form":"Do you know if + 문장?","meaning":"~인지 아세요?","examples":[["Do you know if it's open?","열려 있는지 아세요?"],["Do you know if the bus stops here?","버스가 여기에 서는지 아세요?"]]},{"cat":"질문과 정보","form":"Do you know where + 주어 + 동사원형?","meaning":"~이 어디 있는지 아세요?","examples":[["Do you know where the church is?","교회가 어디인지 아세요?"],["Do you know where my bag is?","제 가방이 어디에 있는지 아세