function finishLesson(){if(!state.done.includes(lesson))state.done.push(lesson);save();$('screen').innerHTML='<div class="panel completed"><div class="circle">'+ic('check')+'</div><div class="label">MISSION COMPLETE</div><h1 style="margin-top:13px">오늘도 해냈어요.</h1><p class="muted">DAY '+lesson+' · '+esc(LESSONS[lesson-1].title)+' 완료 · 오답 재도전 '+answers.filter(x=>!x).length+'회</p><div class="stats" style="margin:0 0 24px"><div class="stat"><span class="label">단어</span><b>'+LESSONS[lesson-1].words.length+'</b></div><div class="stat"><span class="label">표현</span><b>5</b></div><div class="stat"><span class="label">최종 정답</span><b>'+quiz.filter(q=>!q.retry).length+'/'+quiz.filter(q=>!q.retry).length+'</b></div></div><button class="button full" onclick="go(\'home\')">홈으로</button>'+(lesson<30?'<button class="button light full" style="margin-top:10px" onclick="startLesson('+(lesson+1)+')">다음 학습</button>':'')+'</div>'}
