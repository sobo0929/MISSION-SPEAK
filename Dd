else if(stage===4){let r=l.expressions[step];content='<div class="progressline"><span>문장 '+(step+1)+' / 2</span><span>단어를 순서대로 선택</span></div><div class="panel"><div class="question">'+esc(r[1])+'</div><div class="answertray">'+built.map(i=>'<button class="tile" onclick="removeTile('+i+')">'+esc(tiles[i])+'</button>').join('')+'</div><div class="tiles">'+tiles.map((t,i)=>'<button class="tile '+(built.includes(i)?'chosen':'')+'" '+(built.includes(i)?'disabled':'')+' onclick="addTile('+i+')">'+esc(t)+'</button>').join('')+'</div>'+(picked!==null?'<div class="feedback">'+(picked?'정확해요!':'다시 순서를 생각해 보세요. 정답: '+esc(r[0]))+'</div>':'')+'<div class="actionrow"><button class="button light" onclick="built=[];picked=null;renderStudy()">다시 하기</button><button class="button" onclick="'+(picked?'nextBuild()':'checkBuild()')+'">'+(picked?'다음':'확인')+'</button></div></div>'}
