function checkBuild(){let r=LESSONS[lesson-1].expressions[step];picked=built.map(i=>tiles[i]).join(' ')===r[0];let k=lesson+':'+r[0];if(!picked)state.missed[k]={day:lesson,en:r[0],ko:r[1]};else delete state.missed[k];save();renderStudy()}
let roleChoices=[];function nextBuild(){if(step===0){step=1;prepareTiles();renderStudy()}else{stage=5;step=0;picked=null;let l=LESSONS[lesson-1],i=l.dialogue.findIndex((d,i)=>d[0]==='You'&&i>0&&l.dialogue[i-1][0]!=='You');if(i<0)i=l.dialogue.findIndex(d=>d[0]==='You');let r=l.dialogue[i][1];roleChoices=shuffle([r,...shuffle(LESSONS.filter(x=>x!==l).map(x=>x.expressions[0][0])).slice(0,3)]);renderStudy()}}
