else if(stage===2){content='<div class="panel"><div class="between"><div><h3>'+esc(l.en)+'</h3><p class="small muted">'+esc(l.desc)+'</p></div><button class="pill" onclick="showTranslations=!showTranslations;renderStudy()">'+(showTranslations?'해석 끄기':'해석 보기')+'</button></div></div><div class="stack" style="margin:18px 0">'+l.dialogue.map(([a,b,c])=>'<div class="bubble '+(a==='You'?'you':'')+'"><div class="speaker">'+esc(a)+'</div>'+esc(b)+(showTranslations?'<div class="translation">'+esc(c)+'</div>':'')+'</div>').join('')+'</div><button class="button full" onclick="lessonMove()">퀴즈 시작 '+ic('arrow')+'</button>'}
