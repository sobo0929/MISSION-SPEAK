function answerLesson(i){let q=quiz[step];picked=i;let correct=q.opts[i]===q.r;answers.push(correct);let key=lesson+':'+q.r[0];if(!correct)state.missed[key]={day:lesson,en:q.r[0],ko:q.r[1]};else delete state.missed[key];save();renderStudy()}
function prepareTiles(){let r=LESSONS[lesson-1].expressions[step];tiles=shuffle(r[0].split(' '));built=[];picked=null}
